#!/bin/bash

# Git pre-commit hook to automatically update README.md
# Place this file in .git/hooks/pre-commit and make it executable

echo "🔄 Auto-updating README.md before commit..."

# Check if Python script exists
if [ ! -f "update_readme.py" ]; then
    echo "❌ update_readme.py not found. Skipping README update."
    exit 0
fi

# Run the README updater
python3 update_readme.py

# Check if README.md was modified
if git diff --cached --name-only | grep -q "README.md"; then
    echo "📝 README.md was already staged for commit"
else
    # Check if README.md was modified by the script
    if git diff --name-only | grep -q "README.md"; then
        echo "📝 README.md updated, adding to commit..."
        git add README.md
    else
        echo "ℹ️  No changes to README.md"
    fi
fi

echo "✅ Pre-commit hook completed" 